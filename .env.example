POSTGRES_DB=pft
POSTGRES_USER=pft
POSTGRES_PASSWORD=changeme

DATABASE_URL=postgresql://pft:changeme@db:5432/pft

JWT_ACCESS_SECRET=replace-with-strong-random-string
JWT_REFRESH_SECRET=replace-with-different-strong-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

SINGLE_USER_MODE=true

UPLOAD_DIR=/data/uploads
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

VITE_API_BASE_URL=http://localhost:4000/api/v1

# Optional local AI experiment (backend only)
AI_TRANSACTIONS_ENABLED=false
AI_TRANSACTIONS_MAX_MESSAGE_LENGTH=2000
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_MS=120000
# Native mode releases after each request. The Ollama Compose override selects application mode.
OLLAMA_MODEL_LIFECYCLE=request
# Bounded fallback retention for request mode only.
OLLAMA_KEEP_ALIVE_SECONDS=60
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
AI_TRANSACTIONS_TIME_ZONE=America/Bogota
