{
  "name": "personal-finance-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Full-stack personal finance tracker — local-only, Docker-deployed.",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "echo 'Use docker compose up for full stack, or run apps individually with npm -w apps/<name> run dev'",
    "build": "npm --workspaces --if-present run build",
    "lint": "npm --workspaces --if-present run lint && eslint tests/e2e playwright.config.ts",
    "typecheck": "npm --workspaces --if-present run typecheck && tsc -p tests/e2e/tsconfig.json --noEmit",
    "test": "npm --workspaces --if-present run test",
    "compose:up": "docker compose up --build -d",
    "compose:down": "docker compose down",
    "compose:logs": "docker compose logs -f",
    "compose:ai:up": "docker compose -f docker-compose.yml -f docker-compose.ollama.yml up --build -d --wait --wait-timeout 180",
    "compose:ai:stop": "docker compose -f docker-compose.yml -f docker-compose.ollama.yml stop",
    "compose:ai:down": "docker compose -f docker-compose.yml -f docker-compose.ollama.yml down",
    "compose:ai:logs": "docker compose -f docker-compose.yml -f docker-compose.ollama.yml logs -f",
    "compose:ai:status": "docker compose -f docker-compose.yml -f docker-compose.ollama.yml ps --all",
    "test:integration": "npm -w apps/backend run test:integration",
    "test:all": "npm test && npm run test:integration && npm run test:e2e",
    "test:e2e": "node tests/e2e/run.mjs",
    "test:e2e:ui": "node tests/e2e/run.mjs --ui",
    "test:ai:live": "tsx apps/backend/tests/ai-evaluation/run.ts",
    "test:ai:batch:live": "tsx apps/backend/tests/ai-evaluation/batches.ts",
    "test:ai:quality:live": "tsx apps/backend/tests/ai-evaluation/quality.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
